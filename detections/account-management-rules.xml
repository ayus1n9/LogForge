<!--
  LogForge Detection Rules Pack: Account Management & Privilege Escalation
  MITRE ATT&CK:
    - T1136.001 (Create Account: Local Account)
    - T1098 (Account Manipulation)
    - T1078.003 (Valid Accounts: Local Accounts)

  Wazuh Windows Ruleset Hierarchy Note:
    - 60100: Base Windows event channel
    - 60109: User account created or modified (Event ID 4720, 4722, etc.)
    - 60144: Member added to security-enabled local group (Event ID 4732)
    - 60145: Member removed from security-enabled local group (Event ID 4733)
-->
<group name="windows,windows_security,logforge_account_mgmt,">

  <!-- Base: New Local User Created (Windows Event ID 4720) -->
  <!-- Inherits from Wazuh default rule 60109 (User account created) -->
  <rule id="100200" level="8">
    <if_sid>60109</if_sid>
    <field name="win.system.eventID">^4720$</field>
    <description>LogForge: New local user account created ($(win.eventdata.targetUserName)) by $(win.eventdata.subjectUserName)</description>
    <mitre>
      <id>T1136.001</id>
    </mitre>
    <group>account_creation,persistence,</group>
  </rule>

  <!-- Member Added to Security-Enabled Local Group (Windows Event ID 4732) -->
  <!--
    Note on Event ID 4732 fields:
      - win.eventdata.targetUserName: The group name (e.g. Administrators)
      - win.eventdata.memberName / win.eventdata.memberSid: The user added to the group
      - win.eventdata.subjectUserName: The administrative actor performing the action
  -->
  <rule id="100201" level="6">
    <if_sid>60144</if_sid>
    <field name="win.system.eventID">^4732$</field>
    <description>LogForge: Member ($(win.eventdata.memberSid)) added to local group $(win.eventdata.targetUserName) by $(win.eventdata.subjectUserName)</description>
    <mitre>
      <id>T1098</id>
    </mitre>
    <group>group_management,privilege_escalation,</group>
  </rule>

  <!-- High-Severity: User added to Privileged Local Group (Administrators / Remote Desktop Users) -->
  <!-- TargetUserName is strictly matched against local privileged groups -->
  <rule id="100202" level="11">
    <if_sid>100201</if_sid>
    <field name="win.eventdata.targetUserName" type="pcre2">(?i)^(?:Administrators|Remote Desktop Users|Backup Operators)$</field>
    <description>LogForge CRITICAL: Member ($(win.eventdata.memberSid)) added to privileged local group $(win.eventdata.targetUserName) by $(win.eventdata.subjectUserName)</description>
    <mitre>
      <id>T1098</id>
      <id>T1078.003</id>
    </mitre>
    <group>privilege_escalation,persistence,</group>
  </rule>

  <!-- Password Reset Attempted (Windows Event ID 4724) -->
  <rule id="100203" level="7">
    <if_sid>60100</if_sid>
    <field name="win.system.eventID">^4724$</field>
    <description>LogForge: Password reset attempted for user $(win.eventdata.targetUserName) by $(win.eventdata.subjectUserName)</description>
    <mitre>
      <id>T1098</id>
    </mitre>
    <group>account_manipulation,</group>
  </rule>

</group>
